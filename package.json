{
  "name": "@chr33s/liquid",
  "version": "12.0.0",
  "description": "A simple, expressive, extensible Liquid template engine for JavaScript \u2014 Shopify, Jekyll and GitHub Pages compatible, for Node.js, browsers, and the CLI, with TypeScript support.",
  "keywords": [
    "express",
    "jinja",
    "liquid",
    "shopify",
    "template engine"
  ],
  "homepage": "https://github.com/chr33s/liquid#readme",
  "bugs": {
    "url": "https://github.com/chr33s/liquid/issues"
  },
  "license": "MIT",
  "author": "Harttle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chr33s/liquid.git"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/liquidjs"
  },
  "bin": {
    "liquid": "./dist/liquid.cli.mjs",
    "liquidjs": "./dist/liquid.cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "types": "./dist/index.d.ts",
    "browser": "./dist/liquid.browser.mjs",
    "import": "./dist/liquid.node.mjs",
    "require": "./dist/liquid.node.cjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint && oxfmt --check src test bin rolldown.config.mjs vitest.config.mts",
    "check": "npm run build && npm run build:compat && npm run build:docs && npm test && npm run test:spec && npm run test:diff && npm run lint && npm run typecheck && npm run perf:diff",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage src test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:spec": "node bin/liquid-spec.mts",
    "test:diff": "node bin/liquid-diff.mts --count 5000",
    "test:demo": "./test/demo/test.sh",
    "perf:diff": "node bin/perf-diff.mts",
    "perf:engines": "cd benchmark && npm run engines",
    "version": "npm run build && npm test",
    "prepare": "npm run build",
    "build": "run-s build:types build:bundles",
    "build:min": "cross-env BUNDLES=min rolldown -c rolldown.config.mjs",
    "build:umd": "cross-env BUNDLES=umd rolldown -c rolldown.config.mjs",
    "build:charmap": "./bin/character-gen.mts > src/util/character.ts && oxfmt src/util/character.ts",
    "build:docs": "run-s build:apidoc check:docs",
    "build:apidoc": "typedoc --options typedoc.json",
    "build:compat": "node bin/build-compat-manifest.mts",
    "format": "oxfmt src test bin rolldown.config.mjs vitest.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:types": "shx rm -rf dist && tsc -p tsconfig.build.json && shx cp src/build/liquid.node.cjs dist/liquid.node.cjs && shx cp src/build/dist-package.json dist/package.json",
    "build:bundles": "rolldown -c rolldown.config.mjs",
    "build:cli": "cross-env BUNDLES=cli rolldown -c rolldown.config.mjs",
    "check:docs": "node bin/check-docs.mts",
    "publish:docs": "node bin/publish-wiki.mts"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "jsdom": "^30.1.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "rolldown": "^1.2.9",
    "semantic-release": "^25.0.9",
    "shx": "^0.4.0",
    "supertest": "^7.2.2",
    "typedoc": "^0.28.20",
    "typedoc-github-wiki-theme": "2.1.1",
    "typedoc-plugin-markdown": "4.13.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "fsevents": true
  },
  "ref": {
    "Shopify/liquid": "4e39ae4cc3da73921923c0669e0fc84a66b2f696",
    "Shopify/liquid-spec": "84bf25e0edbca5f7e530574788b0f875ab331f50"
  }
}
