{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "dom"
    ],
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vitest/globals"
    ],
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "allowJs": true
  },
  "include": [
    "src",
    "test",
    "bin",
    "vitest.config.mts",
    "rolldown.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "demo",
    "docs",
    "benchmark"
  ]
}
